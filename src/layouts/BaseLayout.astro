---
// ============================================================
// PLANTILLA BASE
// Esqueleto común a todas las páginas: <head>, cabecera,
// contenido (<slot />) y pie. Es como el _Layout.cshtml
// de ASP.NET, y <slot /> equivale a @RenderBody().
// ============================================================
import '../styles/global.css';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import { getContent } from '../data';
import { routes } from '../data/routes';
import type { Lang, PageKey } from '../data/types';

interface Props {
  lang: Lang;
  page: PageKey; // Qué página es: sirve para el título y para marcar el menú
}

const { lang, page } = Astro.props;
const t = getContent(lang);
const { title, description } = t.pages[page];

// URLs absolutas de esta página en cada idioma (para Google)
const esUrl = new URL(routes[page].es, Astro.site);
const enUrl = new URL(routes[page].en, Astro.site);
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0b0f19" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <link rel="alternate" hreflang="es" href={esUrl} />
    <link rel="alternate" hreflang="en" href={enUrl} />

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />

    <!-- Tipografías: Plus Jakarta Sans (texto) y JetBrains Mono (código) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;600&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <a class="skip-link" href="#contenido">{lang === 'es' ? 'Saltar al contenido' : 'Skip to content'}</a>
    <Header lang={lang} page={page} />
    <main id="contenido">
      <slot />
    </main>
    <Footer lang={lang} />
  </body>
</html>

<style>
  /* Enlace oculto que aparece al pulsar Tab: ayuda a quien navega con teclado */
  .skip-link {
    position: absolute;
    left: 1rem;
    top: -3rem;
    z-index: 100;
    padding: 0.5rem 1rem;
    border-radius: var(--radius-sm);
    background: var(--indigo);
    color: #fff;
  }

  .skip-link:focus { top: 1rem; }
</style>
