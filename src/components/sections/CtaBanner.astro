---
// ============================================================
// BANNER DE LLAMADA A LA ACCIÓN (final de cada página)
// Los botones se pasan dentro: <CtaBanner ...><a>...</a></CtaBanner>
// ============================================================
interface Props {
  pill: string;
  title: string;
  text: string;
}

const { pill, title, text } = Astro.props;
---

<section class="container section">
  <div class="card cta">
    <div class="cta__glow" aria-hidden="true"></div>
    <div class="cta__content">
      <span class="pill pill--emerald"><span class="live-dot" aria-hidden="true"></span>{pill}</span>
      <h2 class="cta__title">{title}</h2>
      <p class="cta__text">{text}</p>
    </div>
    <div class="cta__actions">
      <slot />
    </div>
  </div>
</section>

<style>
  .cta {
    display: grid;
    gap: 2rem;
    align-items: center;
    overflow: hidden;
    padding: clamp(2rem, 6vw, 3.5rem);
    background: linear-gradient(135deg, #111827, #161f30 55%, #0f172a);
  }

  @media (min-width: 60rem) {
    .cta { grid-template-columns: 1fr auto; }
  }

  .cta__glow {
    position: absolute;
    right: -4rem;
    bottom: -4rem;
    width: 20rem;
    height: 20rem;
    border-radius: 50%;
    background: rgba(99, 102, 241, 0.2);
    filter: blur(60px);
    pointer-events: none;
  }

  .cta__content { position: relative; display: grid; gap: 1rem; max-width: 40rem; }

  .cta__title {
    font-size: clamp(1.9rem, 4.5vw, 3rem);
    font-weight: 800;
    letter-spacing: -0.03em;
  }

  .cta__text { color: var(--text-soft); }

  .cta__actions {
    position: relative;
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }
</style>
