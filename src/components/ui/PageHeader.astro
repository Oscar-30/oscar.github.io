---
// ============================================================
// CABECERA DE PÁGINA (Proyectos, Sobre mí, Contacto)
// Insignia + título con parte en degradado + introducción.
// Lo que pongas dentro (<PageHeader>...</PageHeader>) aparece debajo.
// ============================================================
interface Props {
  eyebrow: string;
  title: string;
  accent: string;   // Parte del título en degradado
  intro: string;
}

const { eyebrow, title, accent, intro } = Astro.props;
---

<section class="container page-header">
  <span class="pill pill--indigo">
    <span class="live-dot" aria-hidden="true"></span>
    {eyebrow}
  </span>
  <h1>{title} <span class="gradient-text">{accent}</span></h1>
  <p class="intro">{intro}</p>
  <slot />
</section>

<style>
  .page-header {
    display: grid;
    gap: 1.1rem;
    padding-top: clamp(2.5rem, 6vw, 3.5rem);
    padding-bottom: 1rem;
  }

  h1 {
    font-size: clamp(2.2rem, 5.5vw, 3.6rem);
    font-weight: 800;
    letter-spacing: -0.03em;
    line-height: 1.08;
  }

  .intro {
    max-width: 44rem;
    font-size: clamp(1.02rem, 1.8vw, 1.15rem);
    color: var(--muted);
  }
</style>
