---
// ============================================================
// FORMACIÓN E IDIOMAS
// ============================================================
import type { Content } from '../data/types';

interface Props {
  education: Content['education'];
}

const { education } = Astro.props;
---

<section class="section" id="education">
  <div class="container section__grid">
    <h2 class="section__title">{education.title}</h2>

    <div class="education">
      <ul class="studies">
        {education.studies.map((study) => (
          <li>
            <h3 class="study__degree">{study.degree}</h3>
            <p class="study__meta">{study.institution}, {study.start} – {study.end}</p>
            {study.note && <p class="study__note">{study.note}</p>}
          </li>
        ))}
      </ul>

      <div>
        <h3 class="languages__title">{education.languagesTitle}</h3>
        <dl class="languages">
          {education.languages.map((language) => (
            <div>
              <dt>{language.name}</dt>
              <dd>{language.level}</dd>
            </div>
          ))}
        </dl>
      </div>
    </div>
  </div>
</section>

<style>
  .education {
    display: grid;
    gap: 2.5rem;
  }

  .studies { display: grid; gap: 1.5rem; }

  .study__degree { font-size: 1.35rem; font-weight: 700; }

  .study__meta { color: var(--muted); margin-top: 0.2rem; }

  .study__note { margin-top: 0.6rem; max-width: 40rem; }

  .languages__title { font-size: 1.1rem; font-weight: 700; }

  .languages {
    margin: 0.6rem 0 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 2.5rem;
  }

  .languages dt { font-weight: 600; }

  .languages dd { margin: 0; color: var(--muted); }
</style>
