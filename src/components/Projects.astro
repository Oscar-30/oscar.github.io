---
// ============================================================
// PROYECTOS: una fila por proyecto con enlaces opcionales.
// ============================================================
import type { Content } from '../data/types';

interface Props {
  projects: Content['projects'];
}

const { projects } = Astro.props;
---

<section class="section" id="projects">
  <div class="container section__grid">
    <div>
      <h2 class="section__title">{projects.title}</h2>
      <p class="projects__intro">{projects.intro}</p>
    </div>

    <ul class="projects">
      {projects.items.map((project) => (
        <li class="project">
          <div class="project__head">
            <h3 class="project__title">{project.title}</h3>
            <div class="project__links">
              {/* Solo se pinta el enlace si existe (como un if en C#) */}
              {project.repo && (
                <a href={project.repo} target="_blank" rel="noopener noreferrer">
                  {projects.repoLabel}
                  <span class="sr-only"> {project.title}</span>
                </a>
              )}
              {project.demo && (
                <a href={project.demo} target="_blank" rel="noopener noreferrer">
                  {projects.demoLabel}
                  <span class="sr-only"> {project.title}</span>
                </a>
              )}
            </div>
          </div>
          <p class="project__description">{project.description}</p>
          <ul class="tags">
            {project.tech.map((t) => <li>{t}</li>)}
          </ul>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .projects__intro {
    color: var(--muted);
    margin-top: 0.75rem;
    font-size: 0.95rem;
  }

  .projects {
    display: grid;
    border-top: 1px solid var(--line);
  }

  .project {
    padding-block: 1.75rem;
    border-bottom: 1px solid var(--line);
    display: grid;
    gap: 0.75rem;
  }

  .project:first-child { padding-top: 1.25rem; }

  .project__head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.5rem 1.5rem;
  }

  .project__title { font-size: 1.5rem; font-weight: 700; }

  .project__links {
    display: flex;
    gap: 1.25rem;
    font-weight: 600;
  }

  .project__description {
    max-width: 40rem;
    color: var(--muted);
  }
</style>
