---
// ============================================================
// CABECERA: iniciales, menú, cambio de idioma y de tema.
// ============================================================
import type { Content, Lang } from '../data/types';
import { profile } from '../data/profile';

interface Props {
  lang: Lang;
  nav: Content['nav'];
}

const { lang, nav } = Astro.props;

// Enlaces del menú. Cada "href" apunta al id de una sección (#about, #experience...).
const links = [
  { href: '#about', label: nav.about },
  { href: '#experience', label: nav.experience },
  { href: '#projects', label: nav.projects },
  { href: '#skills', label: nav.skills },
  { href: '#contact', label: nav.contact },
];

// Si estamos en español, el botón lleva a /en/ y al revés.
const otherLangHref = lang === 'es' ? '/en/' : '/';
const otherLang = lang === 'es' ? 'en' : 'es';
---

<header class="header">
  <div class="container header__inner">
    <a href="#top" class="header__brand" aria-label={profile.name}>{profile.initials}</a>

    <nav aria-label={lang === 'es' ? 'Principal' : 'Main'}>
      <ul class="header__links">
        {links.map((link) => (
          <li><a href={link.href}>{link.label}</a></li>
        ))}
      </ul>
    </nav>

    <div class="header__actions">
      <a href={otherLangHref} hreflang={otherLang} lang={otherLang} class="header__lang">
        {nav.switchLang}
      </a>
      <button type="button" class="header__theme" id="theme-toggle" aria-label={nav.themeLabel}>
        <!-- Icono de sol (se ve en modo oscuro) -->
        <svg class="icon-sun" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
          <circle cx="12" cy="12" r="4" />
          <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" />
        </svg>
        <!-- Icono de luna (se ve en modo claro) -->
        <svg class="icon-moon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z" />
        </svg>
      </button>
    </div>
  </div>
</header>

<script>
  // Este JavaScript se ejecuta en el navegador.
  // Al pulsar el botón, alterna entre claro y oscuro y lo recuerda.
  const button = document.getElementById('theme-toggle');

  button?.addEventListener('click', () => {
    const root = document.documentElement;
    const next = root.dataset.theme === 'dark' ? 'light' : 'dark';
    root.dataset.theme = next;
    try { localStorage.setItem('theme', next); } catch (e) {}
  });
</script>

<style>
  /* Los estilos dentro de un .astro solo afectan a este componente. */
  .header {
    position: sticky;
    top: env(safe-area-inset-top, 0px);
    z-index: 10;
    background: color-mix(in srgb, var(--bg) 88%, transparent);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--line);
  }

  .header__inner {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    min-height: 4rem;
  }

  .header__brand {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 1.25rem;
    color: var(--ink);
    text-decoration: none;
    letter-spacing: -0.03em;
  }

  .header__links {
    display: none;
    gap: 1.5rem;
  }

  .header__links a {
    color: var(--muted);
    text-decoration: none;
    font-size: 0.95rem;
  }

  .header__links a:hover { color: var(--ink); }

  .header__actions {
    margin-left: auto;
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .header__lang {
    font-size: 0.9rem;
    color: var(--ink);
    text-decoration: none;
    padding: 0.35rem 0.75rem;
    border: 1px solid var(--line);
    border-radius: 999px;
  }

  .header__lang:hover { border-color: var(--accent); }

  .header__theme {
    display: grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    border: 1px solid var(--line);
    border-radius: 50%;
    background: transparent;
    color: var(--ink);
    cursor: pointer;
  }

  .header__theme:hover { border-color: var(--accent); }

  /* Mostrar solo el icono que toca según el tema.
     :global() permite leer el atributo de <html>, que está fuera del componente. */
  .icon-sun { display: none; }
  :global([data-theme='dark']) .icon-sun { display: block; }
  :global([data-theme='dark']) .icon-moon { display: none; }

  /* En pantallas grandes se muestra el menú completo */
  @media (min-width: 52rem) {
    .header__links { display: flex; }
  }
</style>
