---
// ============================================================
// CONTACTO: correo y redes.
// ============================================================
import type { Content } from '../data/types';
import { profile } from '../data/profile';

interface Props {
  contact: Content['contact'];
}

const { contact } = Astro.props;
---

<section class="section contact" id="contact">
  <div class="container section__grid">
    <h2 class="section__title">{contact.title}</h2>

    <div>
      <p class="contact__text">{contact.text}</p>

      <a class="contact__email" href={`mailto:${profile.email}`}>
        <span class="sr-only">{contact.emailLabel}: </span>{profile.email}
      </a>

      <ul class="contact__links">
        {profile.github && (
          <li><a href={profile.github} target="_blank" rel="noopener noreferrer">GitHub</a></li>
        )}
        {profile.linkedin && (
          <li><a href={profile.linkedin} target="_blank" rel="noopener noreferrer">LinkedIn</a></li>
        )}
      </ul>
    </div>
  </div>
</section>

<style>
  .contact__text {
    max-width: 36rem;
    font-size: 1.15rem;
    color: var(--muted);
  }

  .contact__email {
    display: inline-block;
    margin-top: 1.5rem;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(1.4rem, 4.5vw, 2.6rem);
    letter-spacing: -0.03em;
    color: var(--ink);
    text-decoration-color: var(--accent);
    text-decoration-thickness: 3px;
    text-underline-offset: 0.18em;
    overflow-wrap: anywhere;
  }

  .contact__email:hover { color: var(--accent); }

  .contact__links {
    display: flex;
    gap: 1.5rem;
    margin-top: 1.5rem;
    font-weight: 600;
  }
</style>
