---
import type { Content } from '../data/types';
import { profile } from '../data/profile';

interface Props {
  footer: Content['footer'];
}

const { footer } = Astro.props;
const year = new Date().getFullYear(); // Se calcula al compilar la web
---

<footer class="footer">
  <div class="container footer__inner">
    <p>© {year} {profile.name}</p>
    <p>{footer.text}</p>
  </div>
</footer>

<style>
  .footer {
    border-top: 1px solid var(--line);
    padding-block: 2rem;
    color: var(--muted);
    font-size: 0.9rem;
  }

  .footer__inner {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.5rem 2rem;
  }
</style>
