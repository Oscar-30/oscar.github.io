---
// ============================================================
// PORTADA: lo primero que se ve. Tu nombre, rol y botones.
// ============================================================
import type { Content, Lang } from '../data/types';
import { profile } from '../data/profile';

interface Props {
  lang: Lang;
  hero: Content['hero'];
}

const { lang, hero } = Astro.props;
---

<section class="hero" id="top">
  <div class="container">
    <p class="hero__status">
      <span class="hero__dot" aria-hidden="true"></span>
      {hero.status}
    </p>

    <h1 class="hero__name">{profile.name}</h1>

    <p class="hero__role">{hero.role}</p>
    <p class="hero__tagline">{hero.tagline}</p>

    <div class="hero__actions">
      <a class="button button--primary" href="#projects">{hero.ctaProjects}</a>
      <a class="button" href={profile.cv[lang]} download>{hero.ctaCv}</a>
    </div>
  </div>
</section>

<style>
  .hero {
    padding-block: clamp(4rem, 12vw, 8rem) clamp(3.5rem, 8vw, 6rem);
  }

  .hero__status {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    font-size: 0.95rem;
    color: var(--muted);
    margin-bottom: 1.75rem;
  }

  .hero__dot {
    flex-shrink: 0;
    width: 0.6rem;
    height: 0.6rem;
    border-radius: 50%;
    background: #1f9d6b;
    box-shadow: 0 0 0 4px color-mix(in srgb, #1f9d6b 20%, transparent);
  }

  /* El nombre es el elemento protagonista de la página */
  .hero__name {
    font-size: clamp(3.25rem, 11vw, 8.5rem);
    font-weight: 800;
    line-height: 0.92;
    letter-spacing: -0.045em;
    max-width: 12ch;
    animation: rise 0.8s cubic-bezier(0.2, 0.7, 0.2, 1) both;
  }

  .hero__role {
    margin-top: 1.75rem;
    font-family: var(--font-display);
    font-size: clamp(1.25rem, 2.6vw, 1.6rem);
    font-weight: 600;
    color: var(--accent);
  }

  .hero__tagline {
    margin-top: 1rem;
    max-width: 38rem;
    font-size: 1.15rem;
    color: var(--muted);
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 2.25rem;
  }

  .button {
    display: inline-block;
    padding: 0.8rem 1.4rem;
    border-radius: 0.6rem;
    border: 1px solid var(--line);
    color: var(--ink);
    text-decoration: none;
    font-weight: 600;
    transition: border-color 0.15s, background-color 0.15s;
  }

  .button:hover { border-color: var(--ink); }

  .button--primary {
    background: var(--accent);
    border-color: var(--accent);
    color: #fff;
  }

  .button--primary:hover {
    background: color-mix(in srgb, var(--accent) 85%, var(--ink));
    border-color: transparent;
  }

  :global([data-theme='dark']) .button--primary { color: #0f1226; }

  /* Única animación de la página: el nombre aparece al cargar */
  @keyframes rise {
    from { opacity: 0; transform: translateY(0.4em); }
    to { opacity: 1; transform: none; }
  }
</style>
