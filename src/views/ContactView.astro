---
// ============================================================
// PÁGINA DE CONTACTO
// Correo con botón de copiar, datos de disponibilidad,
// perfiles en la red y descarga del CV.
// ============================================================
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/ui/Icon.astro';
import PageHeader from '../components/ui/PageHeader.astro';
import CopyButton from '../components/ui/CopyButton.astro';
import { getContent } from '../data';
import { profile } from '../data/profile';
import type { Lang } from '../data/types';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = getContent(lang);
const c = t.contact;
---

<BaseLayout lang={lang} page="contact">
  <PageHeader eyebrow={c.eyebrow} title={c.title} accent={c.titleAccent} intro={c.intro}>
    <ul class="meta">
      {c.meta.map((item) => (
        <li><Icon name={item.icon} size={14} /> {item.text}</li>
      ))}
    </ul>
  </PageHeader>

  <section class="container section contact">
    <!-- Correo -->
    <article class="card direct">
      <div class="direct__head">
        <h2><Icon name="zap" size={20} class="direct__zap" /> {c.direct.title}</h2>
        <span class="pill pill--emerald"><span class="live-dot" aria-hidden="true"></span>{c.direct.badge}</span>
      </div>
      <p class="direct__text">{c.direct.text}</p>

      <div class="inset inbox">
        <span class="icon-box"><Icon name="mail" size={18} /></span>
        <div class="inbox__body">
          <span class="inbox__label">{c.direct.inboxLabel}</span>
          <a class="inbox__email" href={`mailto:${profile.email}`}>{profile.email}</a>
        </div>
        <CopyButton text={profile.email} label={t.labels.copy} done={t.labels.copied} />
      </div>

      <ul class="tiles">
        {c.tiles.map((tile) => (
          <li class="inset tile">
            <span class="tile__label"><Icon name={tile.icon} size={14} /> {tile.label}</span>
            <strong>{tile.value}</strong>
            <span class="tile__note">{tile.note}</span>
          </li>
        ))}
      </ul>

      <a class="btn btn--primary direct__send" href={`mailto:${profile.email}`}>
        <Icon name="mail" size={17} /> {t.home.cta.button} <Icon name="arrow-right" size={16} />
      </a>
    </article>

    <div class="side">
      <!-- Perfiles -->
      <article class="card">
        <div class="direct__head">
          <h2><Icon name="globe" size={20} class="direct__zap" /> {c.profiles.title}</h2>
          <span class="side__aside">{c.profiles.aside}</span>
        </div>
        <ul class="profiles">
          {profile.links.map((link) => (
            <li>
              <a class="inset profile" href={link.url} target="_blank" rel="noopener noreferrer">
                <span class="icon-box"><Icon name={link.icon} size={18} /></span>
                <span class="profile__body">
                  <strong>{link.name}</strong>
                  <span>{link.handle}</span>
                </span>
                <Icon name="arrow-up-right" size={16} class="profile__arrow" />
              </a>
            </li>
          ))}
        </ul>
      </article>

      <!-- CV -->
      <a class="card cv" href={profile.cv[lang]} download>
        <span class="live-dot" aria-hidden="true"></span>
        <span class="cv__body">
          <strong>{c.cv.title}</strong>
          <span>{c.cv.text}</span>
        </span>
        <span class="cv__tag">PDF <Icon name="download" size={13} /></span>
      </a>
    </div>
  </section>
</BaseLayout>

<style>
  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--muted);
  }

  .meta li { display: inline-flex; align-items: center; gap: 0.4rem; }

  .meta :global(svg) { color: var(--emerald); }

  .contact { display: grid; gap: 1.5rem; align-items: start; padding-top: 2rem; }

  @media (min-width: 60rem) {
    .contact { grid-template-columns: 7fr 5fr; }
  }

  /* ----- Correo ----- */
  .direct { display: grid; gap: 1.25rem; }

  .direct__head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
  }

  .direct__head h2 {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 1.35rem;
    font-weight: 700;
  }

  .direct :global(.direct__zap),
  .side :global(.direct__zap) { color: var(--indigo-light); }

  .direct__text { margin-top: -0.5rem; font-size: 0.92rem; color: var(--text-soft); }

  .inbox {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.85rem;
    padding: 1rem;
  }

  .inbox__body { display: grid; flex: 1; min-width: 12rem; }

  .inbox__label {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .inbox__email {
    font-family: var(--font-mono);
    font-size: 0.95rem;
    color: var(--text);
    overflow-wrap: anywhere;
  }

  .inbox__email:hover { color: var(--indigo-light); }

  .tiles { display: grid; gap: 0.75rem; }

  @media (min-width: 36rem) { .tiles { grid-template-columns: repeat(3, 1fr); } }

  .tile { display: grid; gap: 0.2rem; }

  .tile__label {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-family: var(--font-mono);
    font-size: 0.66rem;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--emerald);
  }

  .tile strong { font-size: 0.95rem; color: var(--text); }

  .tile__note { font-family: var(--font-mono); font-size: 0.7rem; color: var(--muted); }

  .direct__send { width: 100%; }

  /* ----- Columna lateral ----- */
  .side { display: grid; gap: 1.25rem; }

  .side__aside {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .profiles { display: grid; gap: 0.75rem; margin-top: 1.25rem; }

  .profile {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    transition: border-color 0.15s, background-color 0.15s;
  }

  .profile:hover { border-color: rgba(99, 102, 241, 0.45); background: rgba(30, 41, 59, 0.8); }

  .profile__body { display: grid; flex: 1; min-width: 0; }

  .profile__body strong { font-size: 0.95rem; color: var(--text); }

  .profile__body span { font-family: var(--font-mono); font-size: 0.72rem; color: var(--muted); overflow-wrap: anywhere; }

  .profile :global(.profile__arrow) { color: var(--muted); }

  .cv {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    padding: 1rem 1.25rem;
    background: rgba(17, 24, 39, 0.9);
    transition: border-color 0.2s;
  }

  .cv:hover { border-color: rgba(6, 182, 212, 0.5); }

  .cv__body { display: grid; flex: 1; }

  .cv__body strong { font-size: 0.9rem; color: var(--text); }

  .cv__body span { font-family: var(--font-mono); font-size: 0.72rem; color: var(--muted); }

  .cv__tag {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    padding: 0.2rem 0.55rem;
    border-radius: 0.3rem;
    border: 1px solid rgba(6, 182, 212, 0.3);
    background: rgba(6, 182, 212, 0.1);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 600;
    color: var(--cyan-light);
  }
</style>
